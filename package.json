{
  "name": "nextjs-app-router-visualizer",
  "version": "0.0.19",
  "description": "Visualize Next.js App Router page navigation flow as Mermaid flowcharts",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nextjs-app-router-visualizer": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sa02045/nextjs-app-router-visualizer.git"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "nextjs",
    "app-router",
    "visualizer",
    "mermaid",
    "flowchart"
  ],
  "author": "devjojo",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/parser": "^7.24.7",
    "@babel/traverse": "^7.24.7",
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.3",
    "open": "^10.1.0"
  },
  "packageManager": "pnpm@9.1.4+sha512.9df9cf27c91715646c7d675d1c9c8e41f6fce88246f1318c1aa6a1ed1aeb3c4f032fcdf4ba63cc69c4fe6d634279176b5358727d8f2cc1e65b65f43ce2f8bfb0",
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^20.14.2",
    "prettier": "^3.3.2",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
